class Solution {
public:
    int dp[10][82];

    int solve(int pos, int rem, int n) {
        if (pos == n)
            return (rem == 0);

        if (dp[pos][rem] != -1)
            return dp[pos][rem];

        int ans = 0;
        for (int d = 0; d <= 9 && d <= rem; d++) {
            ans += solve(pos + 1, rem - d, n);
        }

        return dp[pos][rem] = ans;
    }

    int countWays(int n, int sum) {
        if (sum > 9 * n || sum < 1)
            return -1;

        memset(dp, -1, sizeof(dp));

        int ans = 0;
        for (int first = 1; first <= 9 && first <= sum; first++) {
            ans += solve(1, sum - first, n);
        }

        return (ans == 0 ? -1 : ans);
    }
};
