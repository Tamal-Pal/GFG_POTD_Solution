class Solution {
public:
    int zigzagSequence(vector<vector<int>>& mat) {
        int n = mat.size();

        vector<int> dp = mat[0];

        for (int i = 1; i < n; i++) {
            // Find largest and second largest values
            int max1 = -1, max2 = -1;
            int idx1 = -1;

            for (int j = 0; j < n; j++) {
                if (dp[j] > max1) {
                    max2 = max1;
                    max1 = dp[j];
                    idx1 = j;
                } 
                else if (dp[j] > max2) {
                    max2 = dp[j];
                }
            }

            vector<int> newDp(n);

            for (int j = 0; j < n; j++) {
                // Cannot choose the same column as previous row
                if (j != idx1)
                    newDp[j] = mat[i][j] + max1;
                else
                    newDp[j] = mat[i][j] + max2;
            }

            dp = newDp;
        }

        return *max_element(dp.begin(), dp.end());
    }
};
