class Solution {
  public:
    int countSubsequences(string& s, int n) {
        const long long MOD = 1000000007LL;
        
        vector<long long> dp(n, 0);

        for (char c : s) {
            int d = c - '0';
            vector<long long> ndp = dp;  // subsequences that skip this digit

            // The digit itself as a subsequence
            ndp[d % n] = (ndp[d % n] + 1) % MOD;

            // Append this digit to every existing subsequence
            for (int r = 0; r < n; ++r) {
                if (dp[r] == 0) continue;

                int nr = (r * 10 + d) % n;
                ndp[nr] = (ndp[nr] + dp[r]) % MOD;
            }

            dp.swap(ndp);
        }

        return dp[0];
    }
};
