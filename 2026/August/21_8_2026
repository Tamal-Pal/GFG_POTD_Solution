class Solution {
  public:
    int transform(string &s1, string &s2) {
        int n = s1.size();

        if (n != (int)s2.size())
            return -1;

        // Check anagram condition.
        vector<int> freq(256, 0);

        for (char c : s1)
            freq[(unsigned char)c]++;

        for (char c : s2)
            freq[(unsigned char)c]--;

        for (int x : freq)
            if (x != 0)
                return -1;

        // Find longest suffix of s1 that can remain in place
        // while the other characters are moved to the front.
        int i = n - 1;
        int j = n - 1;

        while (i >= 0 && j >= 0) {
            if (s1[i] == s2[j]) {
                i--;
                j--;
            } else {
                i--;
            }
        }

        return j + 1;
    }
};
