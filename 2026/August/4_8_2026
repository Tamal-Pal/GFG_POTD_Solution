class Solution {
public:
    int countPairs(vector<int>& arr, int k) {
        if (k <= 0) return 0;

        sort(arr.begin(), arr.end());

        int n = arr.size();
        long long ans = 0;
        int i = 0;

        for (int j = 0; j < n; j++) {
            while (i < j && arr[j] - arr[i] >= k)
                i++;

            ans += (j - i);
        }

        return (int)ans;
    }
};
