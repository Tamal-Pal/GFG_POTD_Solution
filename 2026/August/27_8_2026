class Solution {
  public:
    int maxArea(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();

        vector<int> height(m, 0);
        int ans = 0;

        for (int i = 0; i < n; i++) {

            // Update heights for the current row.
            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 1)
                    height[j]++;
                else
                    height[j] = 0;
            }

            // Sort a COPY, not the original heights.
            vector<int> sortedHeight = height;
            sort(sortedHeight.begin(), sortedHeight.end(), greater<int>());

            // After column swaps, the largest k columns
            // can be placed together.
            for (int k = 1; k <= m; k++) {
                int area = sortedHeight[k - 1] * k;
                ans = max(ans, area);
            }
        }

        return ans;
    }
};
