class Solution {
  public:
    vector<int> getMarks(vector<int> &l, vector<int> &r, vector<int> &rank) {
        int n = l.size();
        
        // prefix[i] = number of valid marks in intervals [0..i]
        vector<long long> prefix(n);
        prefix[0] = (long long)r[0] - l[0] + 1;
        
        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + (long long)r[i] - l[i] + 1;
        }
        
        vector<int> ans;
        
        for (int k : rank) {
            // Find first interval whose cumulative count >= k
            int idx = lower_bound(prefix.begin(), prefix.end(), (long long)k)
                      - prefix.begin();
            
            // Number of marks covered before this interval
            long long before = (idx == 0 ? 0 : prefix[idx - 1]);
            
            // Position inside the interval (0-based)
            long long offset = k - before - 1;
            
            ans.push_back((int)(l[idx] + offset));
        }
        
        return ans;
    }
};
