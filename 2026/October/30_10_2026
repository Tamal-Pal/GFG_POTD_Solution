
class Solution {
    public int cntSubsets(int arr[], int l, int r) {
        final long MOD = 1000000007L;
        
        int n = arr.length;
        
        // Count frequency of numbers from 0 to r
        int[] freq = new int[r + 1];
        
        for (int x : arr) {
            if (x <= r) {
                freq[x]++;
            }
        }
        
        // Precompute powers of 2
        long[] pow2 = new long[n + 1];
        pow2[0] = 1;
        
        for (int i = 1; i <= n; i++) {
            pow2[i] = (pow2[i - 1] * 2) % MOD;
        }
        
        long product = 1;
        long sumBelow = 0;
        long ans = 0;
        
        for (int k = 0; k <= r; k++) {
            
            // Number of subsets with exactly MEX = k
            if (k >= l) {
                int remaining = n - (int)sumBelow - freq[k];
                
                long ways = (product * pow2[remaining]) % MOD;
                
                ans = (ans + ways) % MOD;
            }
            
            // Every number smaller than the next MEX
            // must appear at least once.
            long choices = (pow2[freq[k]] - 1 + MOD) % MOD;
            
            product = (product * choices) % MOD;
            
            sumBelow += freq[k];
        }
        
        return (int)ans;
    }
}
