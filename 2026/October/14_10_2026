class Solution {
    public String findRollOut(String s, int[] roll) {
        int n = s.length();
        int[] freq = new int[n + 1];

        // Count how many operations affect each position
        for (int x : roll) {
            freq[x - 1]++;
        }

        // Calculate suffix sum of operations
        for (int i = n - 2; i >= 0; i--) {
            freq[i] += freq[i + 1];
        }

        char[] arr = s.toCharArray();

        for (int i = 0; i < n; i++) {
            int shift = freq[i] % 26;
            arr[i] = (char) ('a' + (arr[i] - 'a' + shift) % 26);
        }

        return new String(arr);
    }
}
