class Solution {
    public ArrayList<ArrayList<Integer>> socialNetwork(int[] arr) {
        ArrayList<ArrayList<Integer>> ans = new ArrayList<>();

        int n = arr.length + 1;

        for (int i = 2; i <= n; i++) {

            // distance[j] = number of links from i to j
            int[] distance = new int[n + 1];

            int cur = i;
            int steps = 0;

            // Follow the friend chain
            while (cur > 1) {
                int next = arr[cur - 2];

                steps++;
                distance[next] = steps;

                cur = next;
            }

            // IMPORTANT:
            // j must be in increasing order
            for (int j = 1; j < i; j++) {
                if (distance[j] > 0) {
                    ArrayList<Integer> temp = new ArrayList<>();
                    temp.add(i);
                    temp.add(j);
                    temp.add(distance[j]);

                    ans.add(temp);
                }
            }
        }

        return ans;
    }
}
