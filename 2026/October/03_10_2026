import java.util.ArrayList;

class Solution {
    public ArrayList<ArrayList<Integer>> formCoils(int n) {
        int m = 4 * n;
        int totalElements = 16 * n * n;
        
        ArrayList<Integer> coil1 = new ArrayList<>();
        ArrayList<Integer> coil2 = new ArrayList<>();
        
        // Direction vectors: Down, Right, Up, Left
        int[] dr = {1, 0, -1, 0};
        int[] dc = {0, 1, 0, -1};
        int dir = 0; // Starts facing Down
        
        int r = 0, c = 0;
        coil1.add(r * m + c + 1);
        
        // 1. Move Down by 4n - 1 steps
        for (int i = 0; i < m - 1; i++) {
            r += dr[dir];
            c += dc[dir];
            coil1.add(r * m + c + 1);
        }
        dir = (dir + 1) % 4; // Turn Right
        
        // 2. Repeat for pairs of lengths: 4n - 2, 4n - 4, ..., 2
        for (int len = m - 2; len >= 2; len -= 2) {
            for (int repeat = 0; repeat < 2; repeat++) {
                for (int i = 0; i < len; i++) {
                    r += dr[dir];
                    c += dc[dir];
                    coil1.add(r * m + c + 1);
                }
                dir = (dir + 1) % 4;
            }
        }
        
        // 3. Construct Coil 2 using the complement property
        for (int val : coil1) {
            coil2.add(totalElements + 1 - val);
        }
        
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        result.add(coil1);
        result.add(coil2);
        
        return result;
    }
}
