
import java.util.*;

class Solution {
    public ArrayList<Integer> update(int n, int[] updates) {
        int[] freq = new int[n + 2];

        for (int j : updates) {
            freq[j]++;
        }

        ArrayList<Integer> ans = new ArrayList<>();
        int count = 0;

        for (int i = 1; i <= n; i++) {
            count += freq[i];
            ans.add(count);
        }

        return ans;
    }
}
