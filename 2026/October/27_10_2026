class Solution {
    public int getMaxWeight(String s) {
        int n = s.length();

        // dp0: maximum weight for the processed prefix
        // dp1: maximum weight when the last character is left single
        int[] dp = new int[n + 1];

        dp[0] = 0;

        for (int i = 1; i <= n; i++) {
            // Leave the current character unpaired: weight 1
            dp[i] = dp[i - 1] + 1;

            // Pair current character with the previous one
            if (i >= 2 && s.charAt(i - 2) != s.charAt(i - 1)) {
                dp[i] = Math.max(dp[i], dp[i - 2] + 4);
            }
        }

        return dp[n];
    }
}
