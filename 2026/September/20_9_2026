class Solution {
    public int largestSubsquare(char mat[][]) {
        int n = mat.length;

        int[][] right = new int[n][n];
        int[][] down = new int[n][n];

        // Count consecutive X's to the right and downward
        for (int i = n - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {
                if (mat[i][j] == 'X') {
                    right[i][j] = 1 + (j + 1 < n ? right[i][j + 1] : 0);
                    down[i][j] = 1 + (i + 1 < n ? down[i + 1][j] : 0);
                }
            }
        }

        int ans = 0;

        // Treat (i, j) as the top-left corner
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                // Possible square side cannot exceed either boundary
                int len = Math.min(right[i][j], down[i][j]);

                while (len > ans) {
                    int bottom = i + len - 1;
                    int rightCol = j + len - 1;

                    if (bottom < n && rightCol < n &&
                        right[bottom][j] >= len &&
                        down[i][rightCol] >= len) {

                        ans = len;
                        break;
                    }

                    len--;
                }
            }
        }

        return ans;
    }
}
