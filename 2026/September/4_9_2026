class Solution {
  public:
    int maxFruits(vector<int>& arr, int m) {
        int n = arr.size();
        m = min(m, n);

        long long window = 0, ans = 0;

        // First window
        for (int i = 0; i < m; i++) {
            window += arr[i];
        }
        ans = window;

        // Slide over the circular array.
        // There are n possible starting positions.
        for (int i = m; i < n + m - 1; i++) {
            window += arr[i % n];
            window -= arr[(i - m) % n];
            ans = max(ans, window);
        }

        return (int)ans;
    }
};
