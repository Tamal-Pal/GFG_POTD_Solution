class Solution {
    static final int MOD = 1000000007;

    public int ways(int x, int y) {
        int n = x + y;
        int r = Math.min(x, y);

        long[] dp = new long[r + 1];
        dp[0] = 1;

        for (int i = 1; i <= n; i++) {
            for (int j = Math.min(i, r); j >= 1; j--) {
                dp[j] = (dp[j] + dp[j - 1]) % MOD;
            }
        }

        return (int) dp[r];
    }
}
