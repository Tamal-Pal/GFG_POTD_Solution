class Solution {
public:
    static const long long MOD = 1000000007LL;

    int palindromicStrings(int n, int k) {
        long long ans = 0;

        // Even length: 2*m
        // Count = P(k, m)
        long long evenWays = 1; // P(k, 0)

        for (int m = 0; 2 * m <= n; ++m) {
            if (m > 0) {
                evenWays = evenWays * (k - m + 1) % MOD;
            }

            // m = 0 represents the empty string, which is NOT allowed.
            if (m > 0) {
                ans = (ans + evenWays) % MOD;
            }
        }

        // Odd length: 2*m + 1
        // Count = k * P(k-1, m)
        long long oddWays = k; // k * P(k-1, 0)

        for (int m = 0; 2 * m + 1 <= n; ++m) {
            if (m > 0) {
                oddWays = oddWays * (k - m) % MOD;
            }

            ans = (ans + oddWays) % MOD;
        }

        return (int)ans;
    }
};
