class Solution {
    int shortestPath(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        boolean[][] safe = new boolean[n][m];

        // Initially, only landmines are unsafe
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                safe[i][j] = mat[i][j] == 1;
            }
        }

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        // Mark landmines and their adjacent cells as unsafe
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (mat[i][j] == 0) {
                    safe[i][j] = false;

                    for (int d = 0; d < 4; d++) {
                        int nr = i + dr[d];
                        int nc = j + dc[d];

                        if (nr >= 0 && nr < n &&
                            nc >= 0 && nc < m) {
                            safe[nr][nc] = false;
                        }
                    }
                }
            }
        }

        boolean[][] visited = new boolean[n][m];

        // {row, column, distance}
        Queue<int[]> q = new LinkedList<>();

        // Start from every safe cell in the first column.
        // Distance starts at 1 because the starting cell counts.
        for (int i = 0; i < n; i++) {
            if (safe[i][0]) {
                q.offer(new int[]{i, 0, 1});
                visited[i][0] = true;
            }
        }

        while (!q.isEmpty()) {
            int[] cur = q.poll();

            int r = cur[0];
            int c = cur[1];
            int dist = cur[2];

            // Reached the last column
            if (c == m - 1) {
                return dist;
            }

            for (int d = 0; d < 4; d++) {
                int nr = r + dr[d];
                int nc = c + dc[d];

                if (nr >= 0 && nr < n &&
                    nc >= 0 && nc < m &&
                    safe[nr][nc] &&
                    !visited[nr][nc]) {

                    visited[nr][nc] = true;
                    q.offer(new int[]{nr, nc, dist + 1});
                }
            }
        }

        return -1;
    }
}
