class Solution {
  public:
    int sameMod(vector<int> &arr) {
        int n = arr.size();
        
        // If all elements are equal, infinitely many k are possible
        bool allSame = true;
        for (int i = 1; i < n; i++) {
            if (arr[i] != arr[0]) {
                allSame = false;
                break;
            }
        }
        
        if (allSame)
            return -1;
        
        // GCD of all differences from arr[0]
        int g = 0;
        for (int i = 1; i < n; i++) {
            g = gcd(g, abs(arr[i] - arr[0]));
        }
        
        // Count divisors of g
        int ans = 0;
        for (int i = 1; i * i <= g; i++) {
            if (g % i == 0) {
                ans++;              // i
                if (i != g / i)
                    ans++;          // g/i
            }
        }
        
        return ans;
    }
};
