class Solution {
    public String findLongestWord(String s, List<String> d) {
        int n = s.length();

        // next[i][c] = first position >= i where character c occurs
        int[][] next = new int[n + 1][26];

        // Initialize last position as -1
        for (int c = 0; c < 26; c++) {
            next[n][c] = -1;
        }

        for (int i = n - 1; i >= 0; i--) {
            // Copy information from i + 1
            System.arraycopy(next[i + 1], 0, next[i], 0, 26);

            // Current character occurs at i
            next[i][s.charAt(i) - 'a'] = i;
        }

        String ans = "";

        for (String word : d) {

            // No need to check shorter words
            if (word.length() < ans.length()) {
                continue;
            }

            if (isSubsequence(word, next, n)) {
                if (word.length() > ans.length() ||
                    (word.length() == ans.length() &&
                     word.compareTo(ans) < 0)) {
                    ans = word;
                }
            }
        }

        return ans;
    }

    private boolean isSubsequence(String word, int[][] next, int n) {
        int pos = 0;

        for (int i = 0; i < word.length(); i++) {
            int ch = word.charAt(i) - 'a';

            if (pos > n || next[pos][ch] == -1) {
                return false;
            }

            // Move to position after matched character
            pos = next[pos][ch] + 1;
        }

        return true;
    }
}
