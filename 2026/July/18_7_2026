class Solution {
public:
    static const int MOD = 1000000007;

    int findWays(vector<vector<int>>& matrix, int k) {
        int n = matrix.size(), m = matrix[0].size();

        // suffix sum of 1's
        vector<vector<int>> suf(n + 1, vector<int>(m + 1, 0));
        for (int i = n - 1; i >= 0; i--) {
            for (int j = m - 1; j >= 0; j--) {
                suf[i][j] = matrix[i][j] + suf[i + 1][j] + suf[i][j + 1] - suf[i + 1][j + 1];
            }
        }

        vector<vector<int>> dp(n, vector<int>(m, 0));

        // Base case: one piece
        for (int i = 0; i < n; i++)
            for (int j = 0; j < m; j++)
                dp[i][j] = (suf[i][j] > 0);

        for (int cut = 2; cut <= k; cut++) {

            vector<vector<int>> ndp(n, vector<int>(m, 0));

            // Horizontal cumulative sums
            vector<vector<int>> down(n + 1, vector<int>(m, 0));
            for (int j = 0; j < m; j++)
                for (int i = n - 1; i >= 0; i--)
                    down[i][j] = (down[i + 1][j] + dp[i][j]) % MOD;

            // Vertical cumulative sums
            vector<vector<int>> right(n, vector<int>(m + 1, 0));
            for (int i = 0; i < n; i++)
                for (int j = m - 1; j >= 0; j--)
                    right[i][j] = (right[i][j + 1] + dp[i][j]) % MOD;

            for (int i = n - 1; i >= 0; i--) {
                for (int j = m - 1; j >= 0; j--) {

                    long long ans = 0;

                    // first valid horizontal cut
                    for (int x = i + 1; x < n; x++) {
                        if (suf[i][j] > suf[x][j]) {
                            ans += down[x][j];
                            break;
                        }
                    }

                    // first valid vertical cut
                    for (int y = j + 1; y < m; y++) {
                        if (suf[i][j] > suf[i][y]) {
                            ans += right[i][y];
                            break;
                        }
                    }

                    ndp[i][j] = ans % MOD;
                }
            }

            dp.swap(ndp);
        }

        return dp[0][0];
    }
};
