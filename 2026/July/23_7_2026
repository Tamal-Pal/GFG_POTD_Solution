class Solution {
public:
    bool canRepresentBST(vector<int> &arr) {
        stack<int> st;
        int root = INT_MIN;

        for (int x : arr) {
            // Current node cannot be in the left subtree
            // of an already processed right subtree.
            if (x < root)
                return false;

            // Move to the right subtree.
            while (!st.empty() && x > st.top()) {
                root = st.top();
                st.pop();
            }

            st.push(x);
        }

        return true;
    }
};
