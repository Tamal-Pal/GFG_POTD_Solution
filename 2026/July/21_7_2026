class Solution {
  public:
    int maxIndexDifference(string &s) {
        int n = s.size();
        vector<int> best(26, -1);   // best reachable ending index for each character
        int ans = -1;

        for (int i = n - 1; i >= 0; i--) {
            int c = s[i] - 'a';
            int endIdx = i;

            if (c < 25 && best[c + 1] != -1)
                endIdx = best[c + 1];

            best[c] = max(best[c], endIdx);

            if (c == 0)
                ans = max(ans, endIdx - i);
        }

        return ans;
    }
};
