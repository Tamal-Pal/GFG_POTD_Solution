class Solution {
public:
    vector<vector<int>> levelSort(vector<int>& arr) {
        vector<vector<int>> ans;
        int n = arr.size();
        int idx = 0, levelSize = 1;

        while (idx < n) {
            int cnt = min(levelSize, n - idx);
            vector<int> level;
            for (int i = 0; i < cnt; i++) {
                level.push_back(arr[idx + i]);
            }
            sort(level.begin(), level.end());
            ans.push_back(level);

            idx += cnt;
            levelSize <<= 1;
        }

        return ans;
    }
};
