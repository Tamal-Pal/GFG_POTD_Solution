class Solution {
  public:
    int maximumSum(vector<vector<int>>& mat, int k) {
        int n = mat.size();

        vector<vector<long long>> pref(n + 1, vector<long long>(n + 1, 0));

        // Build 2D prefix sum
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                pref[i][j] = mat[i - 1][j - 1]
                           + pref[i - 1][j]
                           + pref[i][j - 1]
                           - pref[i - 1][j - 1];
            }
        }

        long long ans = LLONG_MIN;

        // Compute every k x k sub-grid sum
        for (int i = k; i <= n; i++) {
            for (int j = k; j <= n; j++) {
                long long sum = pref[i][j]
                              - pref[i - k][j]
                              - pref[i][j - k]
                              + pref[i - k][j - k];
                ans = max(ans, sum);
            }
        }

        return (int)ans;
    }
};
