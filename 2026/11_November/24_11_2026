import java.util.*;

class Solution {
    public ArrayList<Integer> findPairs(int[] arr) {
        int n = arr.length;
        Map<Integer, List<int[]>> sumMap = new HashMap<>();

        // Collect all pairs (i, j) with i < j in lexicographical order
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int sum = arr[i] + arr[j];
                sumMap.computeIfAbsent(sum, k -> new ArrayList<>()).add(new int[]{i, j});
            }
        }

        int[] best = null;

        for (List<int[]> pairs : sumMap.values()) {
            int m = pairs.size();
            for (int idx1 = 0; idx1 < m; idx1++) {
                int[] p1 = pairs.get(idx1);
                int a = p1[0], b = p1[1];

                // If 'best' already has a strictly smaller (a, b), no need to continue for this sum
                if (best != null && (a > best[0] || (a == best[0] && b > best[1]))) {
                    break;
                }

                for (int idx2 = idx1 + 1; idx2 < m; idx2++) {
                    int[] p2 = pairs.get(idx2);
                    int c = p2[0], d = p2[1];

                    if (a != c && a != d && b != c && b != d) {
                        int[] candidate = new int[]{a, b, c, d};
                        if (best == null || isLexSmaller(candidate, best)) {
                            best = candidate;
                        }
                        // First valid (c, d) for this (a, b) is lexicographically smallest
                        break;
                    }
                }
            }
        }

        if (best == null) {
            return new ArrayList<>(Arrays.asList(-1, -1, -1, -1));
        }

        ArrayList<Integer> ans = new ArrayList<>(4);
        for (int x : best) {
            ans.add(x);
        }
        return ans;
    }

    private boolean isLexSmaller(int[] cand, int[] best) {
        for (int i = 0; i < 4; i++) {
            if (cand[i] != best[i]) {
                return cand[i] < best[i];
            }
        }
        return false;
    }
}
