
import java.util.*;

class Solution {

    int[] parent, size;

    int find(int x) {
        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }
        return parent[x];
    }

    long union(int u, int v) {
        int pu = find(u);
        int pv = find(v);

        if (pu == pv) return 0;

        long paths = (long) size[pu] * size[pv];

        if (size[pu] < size[pv]) {
            int temp = pu;
            pu = pv;
            pv = temp;
        }

        parent[pv] = pu;
        size[pu] += size[pv];

        return paths;
    }

    public ArrayList<Integer> maximumWeight(
            int n, int[][] edges, int[] queries) {

        Arrays.sort(edges, (a, b) ->
            Integer.compare(a[2], b[2])
        );

        int q = queries.length;

        int[][] sortedQueries = new int[q][2];

        for (int i = 0; i < q; i++) {
            sortedQueries[i][0] = queries[i];
            sortedQueries[i][1] = i;
        }

        Arrays.sort(sortedQueries, (a, b) ->
            Integer.compare(a[0], b[0])
        );

        parent = new int[n + 1];
        size = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            parent[i] = i;
            size[i] = 1;
        }

        long[] ans = new long[q];

        long total = 0;
        int edgeIndex = 0;

        for (int i = 0; i < q; i++) {

            int limit = sortedQueries[i][0];
            int originalIndex = sortedQueries[i][1];

            while (edgeIndex < edges.length &&
                   edges[edgeIndex][2] <= limit) {

                int u = edges[edgeIndex][0];
                int v = edges[edgeIndex][1];

                total += union(u, v);

                edgeIndex++;
            }

            ans[originalIndex] = total;
        }

        ArrayList<Integer> result = new ArrayList<>();

        for (int i = 0; i < q; i++) {
            result.add((int) ans[i]);
        }

        return result;
    }
}
