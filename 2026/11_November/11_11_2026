
class Solution {
    public boolean checkWithinK(int[] arr, int k) {
        HashSet<Integer> set = new HashSet<>();

        for (int i = 0; i < arr.length; i++) {

            // Check if the element already exists
            if (set.contains(arr[i])) {
                return true;
            }

            // Add current element
            set.add(arr[i]);

            // Maintain window size k
            if (set.size() > k) {
                set.remove(arr[i - k]);
            }
        }

        return false;
    }
}
