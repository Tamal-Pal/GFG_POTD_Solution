
class Solution {
    public int findKthSmall(int[] arr, int k) {
        int low = 1;
        int high = 2000000;

        while (low < high) {
            int mid = low + (high - low) / 2;

            int count = 0;

            for (int num : arr) {
                if (num <= mid) {
                    count++;
                }
            }

            int missing = mid - count;

            if (missing >= k) {
                high = mid;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
}
