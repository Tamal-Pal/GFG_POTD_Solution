class Solution {
    public int subarrayXor(int[] arr) {
        int n = arr.length;

        // If n is even, every element contributes an even
        // number of times, so the result is 0.
        if (n % 2 == 0) {
            return 0;
        }

        int ans = 0;

        // If n is odd, only elements at even indices
        // contribute to the final XOR.
        for (int i = 0; i < n; i += 2) {
            ans ^= arr[i];
        }

        return ans;
    }
}
