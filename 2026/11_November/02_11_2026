class Solution {
    public int largestSumCycle(int[] edge) {
        int n = edge.length;

        int[] visited = new int[n];
        int[] position = new int[n];

        int maxSum = -1;
        int id = 0;

        for (int i = 0; i < n; i++) {
            if (visited[i] != 0) {
                continue;
            }

            id++;
            int curr = i;
            int step = 0;

            while (curr != -1 && visited[curr] == 0) {
                visited[curr] = id;
                position[curr] = step++;

                curr = edge[curr];
            }

            // Check if the node belongs to the current path
            if (curr != -1 && visited[curr] == id) {
                int sum = 0;
                int node = curr;

                while (true) {
                    sum += node;
                    node = edge[node];

                    if (node == curr) {
                        break;
                    }
                }

                maxSum = Math.max(maxSum, sum);
            }
        }

        return maxSum;
    }
}
