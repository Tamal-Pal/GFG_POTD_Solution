
class Solution {
    public boolean findPattern(String s) {
        int i = 0;
        int n = s.length();

        while (i < n) {
            // Count consecutive x's
            int xCount = 0;
            while (i < n && s.charAt(i) == 'x') {
                xCount++;
                i++;
            }

            // At least one x is required
            if (xCount == 0) {
                return false;
            }

            // Count consecutive y's
            int yCount = 0;
            while (i < n && s.charAt(i) == 'y') {
                yCount++;
                i++;
            }

            // Both counts must be equal
            if (xCount != yCount) {
                return false;
            }
        }

        return true;
    }
}
