class Solution {
public:
    static const int MOD = 1000000007;

    int n, m;
    vector<vector<int>> apple;
    vector<vector<vector<int>>> dp;

    int solve(int r, int c, int cuts) {
        if (apple[r][c] == 0) return 0;      // no 1 present
        if (cuts == 1) return 1;             // last piece

        int &ans = dp[r][c][cuts];
        if (ans != -1) return ans;

        ans = 0;

        // Horizontal cuts
        for (int nr = r; nr < n - 1; nr++) {
            if (apple[r][c] - apple[nr + 1][c] > 0) {
                ans = (ans + solve(nr + 1, c, cuts - 1)) % MOD;
            }
        }

        // Vertical cuts
        for (int nc = c; nc < m - 1; nc++) {
            if (apple[r][c] - apple[r][nc + 1] > 0) {
                ans = (ans + solve(r, nc + 1, cuts - 1)) % MOD;
            }
        }

        return ans;
    }

    int findWays(vector<vector<int>>& matrix, int k) {
        n = matrix.size();
        m = matrix[0].size();

        // apple[r][c] = number of 1s in submatrix (r,c) -> (n-1,m-1)
        apple.assign(n + 1, vector<int>(m + 1, 0));

        for (int i = n - 1; i >= 0; i--) {
            for (int j = m - 1; j >= 0; j--) {
                apple[i][j] = matrix[i][j]
                            + apple[i + 1][j]
                            + apple[i][j + 1]
                            - apple[i + 1][j + 1];
            }
        }

        dp.assign(n, vector<vector<int>>(m, vector<int>(k + 1, -1)));

        return solve(0, 0, k);
    }
};
